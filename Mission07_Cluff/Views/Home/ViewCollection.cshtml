@model IEnumerable<MIssion07_Cluff.Models.Application>

@{
    ViewData["Title"] = "Movie Collection";
}

<div class="container mt-5">

    @* Success/error feedback from add, edit, or delete actions *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* Page header with Add Movie shortcut *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Joel's Movie Collection</h2>
            <p class="text-muted mb-0">@Model.Count() movie(s) in collection</p>
        </div>
        <a asp-action="AddMovie" class="btn btn-primary">
            + Add Movie
        </a>
    </div>

    @if (!Model.Any())
    {
        @* Empty state message *@
        <div class="alert alert-info text-center py-5">
            <h5>No movies yet!</h5>
            <p class="mb-3">Start building the collection by adding the first movie.</p>
            <a asp-action="AddMovie" class="btn btn-primary">Add a Movie</a>
        </div>
    }
    else
    {
        @* Main movie table with Bootstrap styling *@
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col">Category</th>
                            <th scope="col">Year</th>
                            <th scope="col">Director</th>
                            <th scope="col">Rating</th>
                            <th scope="col" class="text-center">Edited</th>
                            <th scope="col">Lent To</th>
                            <th scope="col" class="text-center">On Plex</th>
                            <th scope="col">Notes</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movie in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@movie.Title</td>
                                <td>@(movie.Category?.CategoryName ?? "—")</td>
                                <td>@movie.Year</td>
                                <td>@(movie.Director ?? "—")</td>

                                @* Rating badge — colored by severity *@
                                <td>
                                    @if (!string.IsNullOrEmpty(movie.Rating))
                                    {
                                        var ratingColor = movie.Rating switch
                                        {
                                            "G" => "success",
                                            "PG" => "info",
                                            "PG-13" => "warning",
                                            "R" => "danger",
                                            _ => "secondary"
                                        };
                                        <span class="badge bg-@ratingColor">@movie.Rating</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                @* Edited indicator *@
                                <td class="text-center">
                                    @if (movie.Edited)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">No</span>
                                    }
                                </td>

                                <td>@(movie.LentTo ?? "—")</td>

                                @* Plex indicator *@
                                <td class="text-center">
                                    @if (movie.CopiedToPlex)
                                    {
                                        <span class="badge bg-info text-dark">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">No</span>
                                    }
                                </td>

                                <td>@(movie.Notes ?? "—")</td>

                                @* Edit and Delete action buttons *@
                                <td class="text-center">
                                    <a asp-action="EditMovie" asp-route-id="@movie.MovieId"
                                       class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                    <a asp-action="DeleteMovie" asp-route-id="@movie.MovieId"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>