@model Mission06_Cluff.Models.Application

@{
    ViewData["Title"] = "Delete Movie";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0">Delete Movie</h2>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <strong>Are you sure you want to delete this movie?</strong> This action cannot be undone.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Title</dt>
                        <dd class="col-sm-8">@Model.Title</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@(Model.Category?.CategoryName ?? "—")</dd>

                        <dt class="col-sm-4">Year</dt>
                        <dd class="col-sm-8">@Model.Year</dd>

                        <dt class="col-sm-4">Director</dt>
                        <dd class="col-sm-8">@(Model.Director ?? "—")</dd>

                        <dt class="col-sm-4">Rating</dt>
                        <dd class="col-sm-8">@(Model.Rating ?? "—")</dd>
                    </dl>

                    <form method="post" asp-action="DeleteMovie" asp-controller="Home">
                        <input type="hidden" name="id" value="@Model.MovieId" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger flex-fill">Yes, Delete It</button>
                            <a asp-action="ViewCollection" class="btn btn-outline-secondary flex-fill">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>