@{
    ViewData["Title"] = "Get to Know Joel";
}

<div class="container mt-5">
    <h1 class="display-4 mb-4">@ViewData["Title"]</h1>
    
    <div class="row">
        <div class="col-md-8">
            <p class="lead">Joel Hilton is a film enthusiast, comedian, and podcaster with an impressive collection of movies spanning decades.</p>
            
            <div class="card mt-4 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Check Out Joel's Work</h5>
                    <ul class="list-unstyled mt-3">
                        <li class="mb-3">
                            <i class="bi bi-mic-fill text-primary me-2"></i>
                            <a href="https://www.qwcomedy.com/" target="_blank" class="text-decoration-none">See Joel at Quick Wits Comedy</a>
                        </li>
                        <li>
                            <i class="bi bi-headphones text-primary me-2"></i>
                            <a href="https://baconsale.com/" target="_blank" class="text-decoration-none">Listen to Bacon Sale Podcast</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <a href="https://baconsale.com/" target="_blank">
                <img src="~/images/BaconsaleKate.jpg" alt="Group picture with the bacon bros" class="img-fluid rounded shadow">
            </a>
        </div>
    </div>
</div>